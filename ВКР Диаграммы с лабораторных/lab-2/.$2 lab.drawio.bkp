        <mxCell id="p1-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Times New Roman;" value="&lt;font style=&quot;font-size: 28px&quot;&gt;&lt;b&gt;UML Core Domain - PDP AR Flow&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px&quot;&gt;Блок 3. Ключевой сценарий: карточка товара - кэш 3D-модели - запуск AR - синхронизация корзины&lt;/font&gt;&lt;/div&gt;" vertex="1">
          
          
          <mxGeometry height="50" width="1500" x="40" y="20" as="geometry" />
          
        
