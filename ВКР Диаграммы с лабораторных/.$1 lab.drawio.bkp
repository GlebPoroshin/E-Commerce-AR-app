          <mxGeometry height="150" width="280" x="1120" y="380" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="buyer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;fontFamily=Times New Roman;" target="system" value="Просматривает каталог,&lt;div&gt;&amp;nbsp;открывает карточку товара,&lt;/div&gt;&lt;div&gt;&amp;nbsp;запускает AR-примерку,&lt;/div&gt;&lt;div&gt;&amp;nbsp;управляет корзиной&lt;/div&gt;">
          <mxGeometry relative="1" x="0.004" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="system" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;fontFamily=Times New Roman;" target="cdn" value="Запрашивает изображения&amp;nbsp;&lt;div&gt;и 3D-модели товаров&lt;/div&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="system" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;fontFamily=Times New Roman;" target="ar_platform" value="Использует датчики устройства &lt;br&gt;и AR-сервисы&lt;div&gt;для примерки мебели в интерьере&lt;/div&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uc_note" parent="1" style="shape=note;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fontSize=14;fontFamily=Times New Roman;" value="&lt;font style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;Акторы, внешние системы и ключевые Use Cases&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Актор: Покупатель.&lt;/div&gt;&lt;div&gt;Внешние системы: CDN / Object Storage, AR-платформа устройства (ARCore / ARKit).&lt;/div&gt;&lt;div&gt;Use Case 1: Покупатель просматривает листинг товаров.&lt;/div&gt;&lt;div&gt;Use Case 2: Покупатель открывает карточку товара и изучает характеристики.&lt;/div&gt;&lt;div&gt;Use Case 3: Покупатель загружает 3D-модель и запускает AR-примерку.&lt;/div&gt;&lt;div&gt;Use Case 4: Покупатель добавляет товар в корзину и меняет количество.&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="530" x="40" y="520" as="geometry" />
        </mxCell>
        <mxCell id="pz" parent="1" style="shape=note;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E2F0D9;strokeColor=#82B366;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;fontSize=14;fontFamily=Times New Roman;" value="&lt;font style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;Описание Для ПЗ&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Контекстная диаграмма показывает систему магазина мебели с AR-примеркой как единый программный продукт. Основным пользователем является покупатель, который просматривает каталог, изучает карточки товаров, запускает AR-сценарий и управляет составом корзины.&lt;/div&gt;&lt;div&gt;Для реализации пользовательских сценариев система взаимодействует с внешним CDN / Object Storage, из которого получает изображения и 3D-модели товаров, а также с AR-платформой устройства, обеспечивающей поиск плоскостей, трекинг и размещение виртуальных объектов. Технологические детали намеренно скрыты, так как они относятся к контейнерному уровню C4.&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="700" x="620" y="580" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
