        <mxCell id="system" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0D5091;resizable=0;fontFamily=Times New Roman;strokeWidth=2;" value="&lt;font style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;Система магазина мебели с AR-примеркой&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[System under Design]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#d9e2f2&quot;&gt;Единая цифровая система для просмотра каталога, карточки товара, AR-примерки и управления корзиной&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="360" x="520" y="245" as="geometry" />
        </mxCell>
        <mxCell id="cdn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;resizable=0;fontFamily=Times New Roman;strokeWidth=2;" value="&lt;font style=&quot;font-size: 18px&quot;&gt;&lt;b&gt;CDN / Object Storage&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[External System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#d9e2f2&quot;&gt;Хранит изображения товаров и 3D-модели, которые загружает клиентское приложение&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="280" x="1120" y="160" as="geometry" />
        </mxCell>
