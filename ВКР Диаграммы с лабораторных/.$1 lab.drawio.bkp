        <mxCell id="de10" edge="1" parent="1" source="armodel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endFill=0;strokeWidth=2;fontSize=13;fontFamily=Times New Roman;" target="policy" value="validates placement">
